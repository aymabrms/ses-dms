{
  "name": "ses-dms",
  "version": "0.1.0",
  "private": true,
  "description": "Socio-Economic Survey and Detailed Measurement Survey Data Collection and Management System",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ses-dms/api --filter @ses-dms/mobile --filter @ses-dms/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
